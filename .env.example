# Durability. Without these two, watchlists, report shares and pulse history stay off
# and the API reports {"durable": false} instead of failing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Read path for chain data. Defaults to the public Robinhood Chain endpoint.
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com

# The live hire rail. Leave unset to use the deployed V1 contract.
NEXT_PUBLIC_HIRE_CONTRACT=
NEXT_PUBLIC_HIRE_CONTRACT_VERSION=1

# The V3 registry (contracts/HireWifV3.sol). Listings, bonds and task-bound payments
# only switch on once this holds a deployed address.
NEXT_PUBLIC_HIRE_V3_CONTRACT=

# Server-side signer that commits each paid answer hash to V3, so a hirer can only
# reclaim from the bond when no answer was committed. Server-only: never expose it.
OPERATOR_PRIVATE_KEY=

# Scheduled alert evaluation (app/api/alerts/run). The route refuses to run without it.
CRON_SECRET=

# Alert delivery. Knock is the notification layer; ALERT_WEBHOOK_URL is a zero-signup
# fallback (Discord/Slack style) so the loop works without a vendor account.
KNOCK_API_KEY=
KNOCK_WORKFLOW=price-alert
ALERT_WEBHOOK_URL=
